{
  "name": "GRAVITINO",
  "type": "MIDDLEWARE",
  "label": "Gravitino",
  "description": "统一元数据管理与开放数据目录",
  "version": "1.3.1-SNAPSHOT",
  "sortNum": 82,
  "dependencies": [],
  "roles": [
    {
      "name": "GravitinoServer",
      "label": "GravitinoServer",
      "roleType": "master",
      "cardinality": "1",
      "logFile": "logs/gravitino-server.log",
      "jmxPortParam": "gravitino.server.webserver.httpPort",
      "portParams": ["gravitino.server.webserver.httpPort"],
      "startRunner": {
        "timeout": "120",
        "program": "bin/gravitino.sh",
        "args": ["start"]
      },
      "stopRunner": {
        "timeout": "600",
        "program": "bin/gravitino.sh",
        "args": ["stop"]
      },
      "statusRunner": {
        "timeout": "60",
        "program": "bin/gravitino.sh",
        "args": ["status"]
      },
      "restartRunner": {
        "timeout": "120",
        "program": "bin/gravitino.sh",
        "args": ["restart"]
      },
      "externalLink": {
        "name": "Gravitino UI",
        "label": "Gravitino UI",
        "url": "http://${host}:${GRAVITINO.gravitino.server.webserver.httpPort}/"
      },
      "hooks": [
        {
          "type": "POST_INSTALL",
          "action": "append_line",
          "params": {
            "line": 49,
            "text": "    exit 1 # datasophon: propagate status exit code",
            "source": "bin/gravitino.sh"
          }
        },
        {
          "type": "POST_INSTALL",
          "action": "download",
          "params": {
            "from": "script/V1.3.0__DDL.sql",
            "to": "db/migration/V1.3.0__DDL.sql",
            "md5": "c2b983facc83a01b522c4ec585213125"
          }
        },
        {
          "type": "POST_INSTALL",
          "action": "link",
          "params": {
            "source": "${ROOT.VosManager.INSTALL_PATH}/datasophon-worker/lib/mysql-connector-j-8.2.0.jar",
            "target": "libs/mysql-connector-j-8.2.0.jar"
          }
        },
        {
          "type": "POST_INSTALL",
          "action": "link",
          "params": {
            "source": "${ROOT.VosManager.INSTALL_PATH}/datasophon-worker/otel/opentelemetry-javaagent.jar",
            "target": "otel/opentelemetry-javaagent.jar"
          }
        },
        {
          "type": "POST_INSTALL",
          "action": "initDb",
          "params": {
            "resourceKey": "GRAVITINO",
            "metaStorage": "datasophon",
            "driver": "com.mysql.cj.jdbc.Driver",
            "url": "jdbc:mysql://${ROOT.Mysql.mysqlHostPort}/gravitino?useUnicode=true&characterEncoding=utf-8&useSSL=false&allowPublicKeyRetrieval=true",
            "username": "gravitino",
            "password": "fI5sQ4yQ4fP5"
          }
        }
      ]
    }
  ],
  "configWriter": {
    "generators": [
      {
        "filename": "gravitino.conf",
        "configFormat": "properties",
        "outputDirectory": "conf",
        "includeParams": [
          "gravitino.server.webserver.host",
          "gravitino.server.webserver.httpPort",
          "gravitino.entity.store",
          "gravitino.entity.store.relational",
          "gravitino.entity.store.relational.jdbcUrl",
          "gravitino.entity.store.relational.jdbcDriver",
          "gravitino.entity.store.relational.jdbcUser",
          "gravitino.entity.store.relational.jdbcPassword",
          "gravitino.audit.enabled",
          "gravitino.lineage.source",
          "gravitino.lineage.processorClass",
          "gravitino.lineage.sinks",
          "gravitino.lineage.sinkQueueCapacity",
          "gravitino.lineage.storage.enabled",
          "gravitino.lineage.storage.jdbcUrl",
          "gravitino.lineage.storage.jdbcDriver",
          "gravitino.lineage.storage.jdbcUser",
          "gravitino.lineage.storage.jdbcPassword",
          "gravitino.lineage.storage.poolMaxSize",
          "gravitino.lineage.storage.connectionTimeoutMs",
          "gravitino.lineage.storage.cacheSyncIntervalSecs",
          "gravitino.lineage.storage.staleThresholdSecs",
          "gravitino.lineage.storage.sourceLaggingThresholdSecs"
        ]
      },
      {
        "filename": "gravitino-env.sh",
        "configFormat": "custom",
        "outputDirectory": "conf",
        "templateName": "gravitino-env.ftl",
        "includeParams": [
          "javaHome",
          "gravitinoMem"
        ]
      }
    ]
  },
  "parameters": [
    {
      "name": "gravitino.server.webserver.host",
      "label": "监听地址",
      "description": "Web Server 监听地址",
      "required": true,
      "configType": "map",
      "type": "input",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "0.0.0.0"
    },
    {
      "name": "gravitino.server.webserver.httpPort",
      "port": true,
      "register": true,
      "label": "端口",
      "description": "Web Server 监听端口",
      "required": true,
      "configType": "map",
      "type": "input",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "8090"
    },
    {
      "name": "gravitino.entity.store",
      "label": "元数据存储类型",
      "description": "元数据存储类型，目前仅支持 relational",
      "required": true,
      "configType": "map",
      "type": "input",
      "configurableInWizard": false,
      "hidden": true,
      "defaultValue": "relational"
    },
    {
      "name": "gravitino.entity.store.relational",
      "label": "元数据存储后端",
      "description": "元数据存储后端实现，目前仅支持 JDBCBackend",
      "required": true,
      "configType": "map",
      "type": "input",
      "configurableInWizard": false,
      "hidden": true,
      "defaultValue": "JDBCBackend"
    },
    {
      "name": "gravitino.entity.store.relational.jdbcUrl",
      "label": "元数据库 JDBC URL",
      "description": "元数据库 JDBC URL，复用平台 MySQL",
      "required": true,
      "configType": "map",
      "type": "input",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "jdbc:mysql://${ROOT.Mysql.mysqlHostPort}/gravitino?useUnicode=true&characterEncoding=utf-8&useSSL=false&allowPublicKeyRetrieval=true"
    },
    {
      "name": "gravitino.entity.store.relational.jdbcDriver",
      "label": "JDBC 驱动类名",
      "description": "JDBC 驱动类名",
      "required": true,
      "configType": "map",
      "type": "input",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "com.mysql.cj.jdbc.Driver"
    },
    {
      "name": "gravitino.entity.store.relational.jdbcUser",
      "label": "数据库用户名",
      "description": "数据库用户名",
      "required": true,
      "configType": "map",
      "type": "input",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "gravitino"
    },
    {
      "name": "gravitino.entity.store.relational.jdbcPassword",
      "label": "数据库密码",
      "description": "数据库密码",
      "required": true,
      "configType": "map",
      "type": "input",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": ""
    },
    {
      "name": "gravitino.audit.enabled",
      "label": "是否启用审计日志",
      "description": "是否启用审计日志",
      "required": true,
      "configType": "map",
      "type": "switch",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": false
    },
    {
      "name": "gravitino.lineage.source",
      "label": "血缘事件接收方式",
      "description": "血缘事件来源，固定走内置 HTTP 接收端点（POST /api/lineage）",
      "required": true,
      "configType": "map",
      "type": "input",
      "configurableInWizard": false,
      "hidden": true,
      "defaultValue": "http"
    },
    {
      "name": "gravitino.lineage.processorClass",
      "label": "血缘事件处理器",
      "description": "固定使用 NoopProcessor；血缘持久化与规范化由 Gravitino 1.3.1-SNAPSHOT 的 lineage 模块完成",
      "required": true,
      "configType": "map",
      "type": "input",
      "configurableInWizard": false,
      "hidden": true,
      "defaultValue": "org.apache.gravitino.lineage.processor.NoopProcessor"
    },
    {
      "name": "gravitino.lineage.sinks",
      "label": "血缘事件 Sink",
      "description": "保留本地日志 Sink 便于排障；权威持久化由独立 lineage MySQL 完成，不再转发 Datasophon",
      "required": true,
      "configType": "map",
      "type": "input",
      "configurableInWizard": false,
      "hidden": true,
      "defaultValue": "log"
    },
    {
      "name": "gravitino.lineage.sinkQueueCapacity",
      "label": "血缘事件 Sink 队列容量",
      "description": "日志 Sink 的异步队列容量",
      "required": true,
      "configType": "map",
      "type": "input",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "10000"
    },
    {
      "name": "gravitino.lineage.storage.enabled",
      "label": "启用血缘 MySQL 持久化",
      "description": "启用 Gravitino 权威血缘存储与 Guava 图快照",
      "required": true,
      "configType": "map",
      "type": "switch",
      "configurableInWizard": false,
      "hidden": true,
      "defaultValue": true
    },
    {
      "name": "gravitino.lineage.storage.jdbcUrl",
      "label": "血缘库 JDBC URL",
      "description": "每个 Datasophon 集群必须使用独立 schema；standalone 集群 1 使用 gravitino_lineage_1，禁止复用 Gravitino 元数据库或 Datasophon 血缘表",
      "required": true,
      "configType": "map",
      "type": "input",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "jdbc:mysql://${ROOT.Mysql.mysqlHostPort}/gravitino_lineage_1?useUnicode=true&characterEncoding=utf-8&useSSL=false&allowPublicKeyRetrieval=true"
    },
    {
      "name": "gravitino.lineage.storage.jdbcDriver",
      "label": "血缘库 JDBC 驱动",
      "description": "独立血缘库 JDBC 驱动类",
      "required": true,
      "configType": "map",
      "type": "input",
      "configurableInWizard": false,
      "hidden": true,
      "defaultValue": "com.mysql.cj.jdbc.Driver"
    },
    {
      "name": "gravitino.lineage.storage.jdbcUser",
      "label": "血缘库用户",
      "description": "独立血缘库 JDBC 用户",
      "required": true,
      "configType": "map",
      "type": "input",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "gravitino"
    },
    {
      "name": "gravitino.lineage.storage.jdbcPassword",
      "label": "血缘库密码",
      "description": "独立血缘库 JDBC 密码",
      "required": true,
      "configType": "map",
      "type": "input",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "fI5sQ4yQ4fP5"
    },
    {
      "name": "gravitino.lineage.storage.poolMaxSize",
      "label": "血缘库连接池上限",
      "description": "血缘 JDBC 连接池最大连接数",
      "required": true,
      "configType": "map",
      "type": "input",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "10"
    },
    {
      "name": "gravitino.lineage.storage.connectionTimeoutMs",
      "label": "血缘库连接超时（毫秒）",
      "description": "获取血缘 JDBC 连接的最大等待时间",
      "required": true,
      "configType": "map",
      "type": "input",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "30000"
    },
    {
      "name": "gravitino.lineage.storage.cacheSyncIntervalSecs",
      "label": "血缘快照刷新周期（秒）",
      "description": "周期刷新、写后刷新和手工刷新共用单线程合并机制",
      "required": true,
      "configType": "map",
      "type": "input",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "180"
    },
    {
      "name": "gravitino.lineage.storage.staleThresholdSecs",
      "label": "血缘快照过期阈值（秒）",
      "description": "超过该年龄或 generation 落后、刷新失败时将快照标记为 stale",
      "required": true,
      "configType": "map",
      "type": "input",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "600"
    },
    {
      "name": "gravitino.lineage.storage.sourceLaggingThresholdSecs",
      "label": "血缘事件断流阈值（秒）",
      "description": "最后接收事件超过该时间后 sourceFreshness 标记为 LAGGING",
      "required": true,
      "configType": "map",
      "type": "input",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "1800"
    },
    {
      "name": "javaHome",
      "label": "java安装路径",
      "description": "java安装路径，Gravitino 1.3.1-SNAPSHOT 强制要求 Java 17+",
      "required": true,
      "configType": "map",
      "type": "input",
      "configurableInWizard": false,
      "hidden": false,
      "defaultValue": "$JAVA_HOME17"
    },
    {
      "name": "gravitinoMem",
      "label": "JVM 内存参数",
      "description": "GRAVITINO_MEM 环境变量，控制堆内存与元空间大小",
      "required": true,
      "configType": "map",
      "type": "input",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "-Xms1024m -Xmx2048m -XX:MaxMetaspaceSize=512m"
    }
  ],
  "arch": {
    "common": {
      "packageName": "gravitino-1.3.1-SNAPSHOT-bin.tar.gz",
      "decompressPackageName": "gravitino-1.3.1-SNAPSHOT-bin"
    }
  }
}
