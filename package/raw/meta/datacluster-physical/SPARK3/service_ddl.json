{
  "name": "SPARK3",
  "type": "MIDDLEWARE",
  "label": "Spark3",
  "description": "分布式计算系统",
  "version": "3.5.8",
  "sortNum": 7,
  "dependencies": [
    "HIVE"
  ],
  "roles": [
    {
      "name": "SparkClient3",
      "label": "SparkClient3",
      "roleType": "client",
      "runAs": {
        "user": "hive",
        "group": "hadoop"
      },
      "cardinality": "1+",
      "logFile": "logs/hadoop-${user}-datanode-${host}.log",
      "hooks": [
        {
          "type": "POST_INSTALL",
          "action": "sh",
          "params": {
            "commands": [
              [
                "mkdir",
                "logs"
              ],
              [
                "cp",
                "/data/install_datasophon/datasophon-worker/lib/mysql-connector-java-8.0.28.jar",
                "jars/"
              ]
            ]
          }
        },
        {
          "type": "POST_INSTALL",
          "action": "nexus",
          "params": {
            "from": "iceberg-spark-runtime-3.4_2.12-1.3.1.jar",
            "to": "jars/iceberg-spark-runtime-3.4_2.12-1.3.1.jar"
          }
        },
        {
          "type": "POST_INSTALL",
          "action": "nexus",
          "params": {
            "from": "spark-doris-connector-spark-3.4-25.2.0.jar",
            "to": "jars/spark-doris-connector-spark-3.4-25.2.0.jar"
          }
        },
        {
          "type": "POST_INSTALL",
          "action": "nexus",
          "params": {
            "from": "plugins/gravitino-spark-connector-runtime-3.5_2.12-1.3.1-SNAPSHOT.jar",
            "to": "jars/gravitino-spark-connector-runtime-3.5_2.12-1.3.1-SNAPSHOT.jar"
          }
        },
        {
          "type": "POST_INSTALL",
          "action": "nexus",
          "params": {
            "from": "plugins/openlineage-spark_2.12-1.29.0.jar",
            "to": "jars/openlineage-spark_2.12-1.29.0.jar"
          }
        },
        {
          "type": "POST_INSTALL",
          "action": "nexus",
          "params": {
            "from": "plugins/paimon-spark-3.5-1.2.0.jar",
            "to": "jars/paimon-spark-3.5-1.2.0.jar"
          }
        }
      ]
    }
  ],
  "configWriter": {
    "generators": [
      {
        "filename": "spark-env.sh",
        "configFormat": "custom",
        "templateName": "spark-env.ftl",
        "outputDirectory": "conf",
        "includeParams": [
          "SPARK_DIST_CLASSPATH",
          "HADOOP_CONF_DIR",
          "YARN_CONF_DIR",
          "custom.spark.env.sh"
        ]
      },
      {
        "filename": "spark-defaults.conf",
        "configFormat": "properties2",
        "outputDirectory": "conf",
        "includeParams": [
          "custom.spark.defaults.conf"
        ]
      }
    ]
  },
  "parameters": [
    {
      "name": "gravitinoLineageToken",
      "label": "Gravitino 血缘/联邦静态 Token",
      "description": "由 GRAVITINO 的 gravitino.authenticator.oauth.defaultSignKey 铸造的静态 JWT；同时用于 Spark 的 Gravitino catalog 联邦认证（spark.sql.gravitino.authType=token）与 OpenLineage 血缘事件上报，两处必须填同一个值。铸造步骤见部署手册。",
      "required": true,
      "configType": "map",
      "type": "input",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": ""
    },
    {
      "name": "SPARK_DIST_CLASSPATH",
      "label": "spark加载Classpath路径",
      "description": "",
      "required": true,
      "configType": "map",
      "type": "input",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "$(${HADOOP_HOME}/bin/hadoop classpath)"
    },
    {
      "name": "HADOOP_CONF_DIR",
      "label": "Hadoop配置文件目录",
      "description": "",
      "configType": "map",
      "required": true,
      "type": "input",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "${HADOOP_HOME}/etc/hadoop"
    },
    {
      "name": "YARN_CONF_DIR",
      "label": "Yarn配置文件目录",
      "description": "",
      "configType": "map",
      "required": true,
      "type": "input",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "${HADOOP_HOME}/etc/hadoop"
    },
    {
      "name": "custom.spark.env.sh",
      "label": "自定义配置spark-env.sh",
      "description": "自定义配置spark-env.sh",
      "configType": "custom",
      "required": false,
      "type": "multipleWithKey",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": [
        {
          "SPARK_CLASSPATH": "${ROOT.VosManager.INSTALL_PATH}/spark3/carbonlib/*"
        },
        {
          "HIVE_HOME": "${ROOT.VosManager.INSTALL_PATH}/hive"
        }
      ]
    },
    {
      "name": "custom.spark.defaults.conf",
      "label": "自定义配置spark-defaults.conf",
      "description": "自定义配置",
      "configType": "custom",
      "required": false,
      "type": "multipleWithKey",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": [
        {
          "spark.sql.hive.metastore.jars": "/data/install_datasophon/hive/lib/*"
        },
        {
          "spark.sql.hive.metastore.version": "3.1.3"
        },
        {
          "spark.yarn.jars": "hdfs:///spark3/jars/*.jar"
        },
        {
          "spark.port.maxRetries": "100"
        },
        {
          "spark.sql.catalogImplementation": "hive"
        },
        {
          "spark.sql.uri": "${HIVE.hive.metastore.uris}"
        },
        {
          "spark.sql.extensions": "org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions"
        },
        {
          "spark.sql.warehouse.dir": "/user/hive/warehouse"
        },
        {
          "spark.plugins": "org.apache.gravitino.spark.connector.plugin.GravitinoSparkPlugin"
        },
        {
          "spark.sql.gravitino.uri": "http://${ROOT.GRAVITINO.__hostIp__}:${ROOT.GRAVITINO.__port__}"
        },
        {
          "spark.sql.gravitino.metalake": "datasophon"
        },
        {
          "spark.sql.gravitino.enablePaimonSupport": "true"
        },
        {
          "spark.sql.gravitino.enableOpenLineageDatasetProperties": "true"
        },
        {
          "spark.sql.gravitino.authType": "token"
        },
        {
          "spark.sql.gravitino.token.value": "${SPARK3.gravitinoLineageToken}"
        },
        {
          "spark.sql.catalog.doris_catalog": "org.apache.doris.spark.catalog.DorisTableCatalog"
        },
        {
          "spark.sql.catalog.doris_catalog.doris.fenodes": "${DORIS.feMaster}:${DORIS.http_port}"
        },
        {
          "spark.sql.catalog.doris_catalog.doris.query.port": "${DORIS.query_port}"
        },
        {
          "spark.sql.catalog.doris_catalog.doris.user": "root"
        },
        {
          "spark.sql.catalog.doris_catalog.doris.password": "${DORIS.root_password}"
        },
        {
          "spark.extraListeners": "io.openlineage.spark.agent.OpenLineageSparkListener"
        },
        {
          "spark.metrics.conf.*.sink.graphite.class": "org.apache.spark.metrics.sink.GraphiteSink"
        },
        {
          "spark.metrics.conf.*.sink.graphite.host": "127.0.0.1"
        },
        {
          "spark.metrics.conf.*.sink.graphite.port": "2003"
        },
        {
          "spark.metrics.conf.*.sink.graphite.period": "10"
        },
        {
          "spark.metrics.conf.*.sink.graphite.unit": "seconds"
        },
        {
          "spark.metrics.conf.*.sink.graphite.regex": "\\.executor\\.(records|bytes|shuffle|threadpool|filesystem)|\\.DAGScheduler\\.(job|stage)\\."
        },
        {
          "spark.openlineage.capturedProperties": "spark.master,spark.app.name,spark.app.id"
        },
        {
          "spark.openlineage.transport.type": "http"
        },
        {
          "spark.openlineage.transport.url": "http://${ROOT.GRAVITINO.__hostIp__}:${ROOT.GRAVITINO.__port__}"
        },
        {
          "spark.openlineage.transport.endpoint": "/api/lineage"
        },
        {
          "spark.openlineage.transport.auth.type": "api_key"
        },
        {
          "spark.openlineage.transport.auth.apiKey": "${SPARK3.gravitinoLineageToken}"
        }
      ]
    }
  ],
  "arch": {
    "common": {
      "packageName": "spark-3.5.8-bin-hadoop3.tgz",
      "decompressPackageName": "spark-3.5.8-bin-hadoop3"
    }
  }
}
