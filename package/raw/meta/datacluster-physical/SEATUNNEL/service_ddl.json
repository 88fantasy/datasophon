  "configWriter": {
    "generators": [
      {
        "filename": "seatunnel-master.yaml",
        "configFormat": "custom",
        "outputDirectory": "config",
        "templateName": "seatunnel.ftl",
        "includeParams": [
          "historyJobExpireMinutes", "checkpointInterval", "checkpointTimeout", "stateBucket", "s3Endpoint", "s3AccessKey", "s3SecretKey", "masterHttpPort"
        ]
      },
      {
        "filename": "seatunnel-worker.yaml",
        "configFormat": "custom",
        "outputDirectory": "config",
        "templateName": "seatunnel.ftl",
        "includeParams": [
          "historyJobExpireMinutes", "checkpointInterval", "checkpointTimeout", "stateBucket", "s3Endpoint", "s3AccessKey", "s3SecretKey", "workerHttpPort"
        ]
      },
      {
        "filename": "hazelcast-master.yaml",
        "configFormat": "custom",
        "outputDirectory": "config",
        "templateName": "hazelcast-master.ftl",
        "includeParams": [
          "clusterName", "masterMembers", "workerMembers", "masterHazelcastPort", "stateBucket", "s3Endpoint", "s3AccessKey", "s3SecretKey"
        ]
      },
      {
        "filename": "hazelcast-worker.yaml",
        "configFormat": "custom",
        "outputDirectory": "config",
        "templateName": "hazelcast-worker.ftl",
        "includeParams": [
          "clusterName", "masterMembers", "workerMembers", "workerHazelcastPort"
        ]
      },
      {
        "filename": "hazelcast-client.yaml",
        "configFormat": "custom",
        "outputDirectory": "config",
        "templateName": "hazelcast-client.ftl",
        "includeParams": [
          "clusterName", "masterMembers"
        ]
      },
      {
        "filename": "jvm_master_options",
        "configFormat": "custom",
        "outputDirectory": "config",
        "templateName": "jvm_master_options.ftl",
        "includeParams": [
          "masterHeapGb"
        ]
      },
      {
        "filename": "jvm_worker_options",
        "configFormat": "custom",
        "outputDirectory": "config",
        "templateName": "jvm_worker_options.ftl",
        "includeParams": [
          "workerHeapGb", "workerDirectMemoryGb"
        ]
      },
      {
        "filename": "seatunnel.yaml",
        "configFormat": "custom",
        "outputDirectory": "config",
        "templateName": "seatunnel.ftl",
        "includeParams": [
          "historyJobExpireMinutes", "checkpointInterval", "checkpointTimeout", "stateBucket", "s3Endpoint", "s3AccessKey", "s3SecretKey", "masterHttpPort"
        ]
      }
    ]
  },
  "parameters": [
    {
      "enabled": true,
      "name": "masterHttpPort",
      "port": true,
      "description": "SeaTunnel Master REST 与 /metrics 端口",
      "label": "Master HTTP 端口",
      "hidden": false,
      "required": true,
      "configType": "map",
      "type": "input",
      "defaultValue": "18088",
      "configurableInWizard": true,
      "register": true
    },
    {
      "enabled": true,
      "name": "workerHttpPort",
      "port": true,
      "description": "SeaTunnel Worker REST 与 /metrics 端口",
      "label": "Worker HTTP 端口",
      "hidden": false,
      "required": true,
      "configType": "map",
      "type": "input",
      "defaultValue": "18089",
      "configurableInWizard": true,
      "register": true
    },
    {
      "enabled": true,
      "name": "masterHazelcastPort",
      "port": true,
