{
  "name": "SEATUNNEL",
  "type": "MIDDLEWARE",
  "label": "SeaTunnel",
  "description": "本地 fork 88fantasy/seatunnel，bcdc44af1 构建，Zeta 引擎",
  "sortNum": 8,
  "version": "3.0.0-SNAPSHOT",
  "createDecompressDir": false,
  "dependencies": [],
  "arch": {
    "x86_64": {
      "packageName": "apache-seatunnel-3.0.0-SNAPSHOT-bin.tar.gz",
      "decompressPackageName": "apache-seatunnel-3.0.0-SNAPSHOT"
    },
    "aarch64": {
      "packageName": "apache-seatunnel-3.0.0-SNAPSHOT-bin.tar.gz",
      "decompressPackageName": "apache-seatunnel-3.0.0-SNAPSHOT"
    }
  },
  "roles": [
    {
      "name": "SeaTunnelMaster",
      "label": "SeaTunnelMaster",
      "sortNum": 1,
      "roleType": "master",
      "cardinality": "2+",
      "logFile": "logs/seatunnel-engine-master.out",
      "serverPorts": [],
      "jmxPortParam": "masterHttpPort",
      "portParams": [
        "masterHttpPort",
        "masterHazelcastPort"
      ],
      "runAs": {},
      "startRunner": {
        "timeout": "60",
        "program": "control.sh",
        "args": [
          "start",
          "master"
        ]
      },
      "stopRunner": {
        "timeout": "600",
        "program": "control.sh",
        "args": [
          "stop",
          "master"
        ]
      },
      "statusRunner": {
        "timeout": "60",
        "program": "control.sh",
        "args": [
          "status",
          "master"
        ]
      },
      "restartRunner": {
        "timeout": "600",
        "program": "control.sh",
        "args": [
          "restart",
          "master"
        ]
      },
      "hooks": [
        {
          "type": "PRE_INSTALL",
          "action": "s3Sync",
          "params": {
            "bucket": "${SEATUNNEL.stateBucket}",
            "endpoint": "http://${ROOT.Rustfs.__hostIp__}:${ROOT.Rustfs.__port__}",
            "accessKey": "${ROOT.Rustfs.access_key}",
            "secretKey": "${ROOT.Rustfs.secret_key}",
            "resourcePath": ""
          }
        },
        {
          "type": "POST_INSTALL",
          "action": "download",
          "params": {
            "from": "script/control.sh",
            "to": "control.sh",
            "md5": "__MD5_control.sh__"
          }
        },
        {
          "type": "POST_INSTALL",
          "action": "append_line",
          "params": {
            "source": "bin/seatunnel-cluster.sh",
            "line": 19,
            "text": "export JAVA_HOME=$JAVA_HOME8"
          }
        },
        {
          "type": "POST_INSTALL",
          "action": "append_line",
          "params": {
            "source": "bin/seatunnel.sh",
            "line": 19,
            "text": "export JAVA_HOME=$JAVA_HOME8"
          }
        },
        {
          "type": "POST_INSTALL",
          "action": "nexus",
          "params": {
            "from": "plugins/seatunnel/connector-jdbc-3.0.0-SNAPSHOT.jar",
            "to": "connectors/connector-jdbc-3.0.0-SNAPSHOT.jar",
            "md5": "__MD5_connector-jdbc-3.0.0-SNAPSHOT.jar__"
          }
        },
        {
          "type": "POST_INSTALL",
          "action": "nexus",
          "params": {
            "from": "plugins/seatunnel/connector-cdc-mysql-3.0.0-SNAPSHOT.jar",
            "to": "connectors/connector-cdc-mysql-3.0.0-SNAPSHOT.jar",
            "md5": "__MD5_connector-cdc-mysql-3.0.0-SNAPSHOT.jar__"
          }
        },
        {
          "type": "POST_INSTALL",
          "action": "nexus",
          "params": {
            "from": "plugins/seatunnel/connector-doris-3.0.0-SNAPSHOT.jar",
            "to": "connectors/connector-doris-3.0.0-SNAPSHOT.jar",
            "md5": "__MD5_connector-doris-3.0.0-SNAPSHOT.jar__"
          }
        },
        {
          "type": "POST_INSTALL",
          "action": "nexus",
          "params": {
            "from": "plugins/seatunnel/mysql-connector-java-8.0.27.jar",
            "to": "lib/mysql-connector-java-8.0.27.jar",
            "md5": "__MD5_mysql-connector-java-8.0.27.jar__"
          }
        }
      ]
    },
