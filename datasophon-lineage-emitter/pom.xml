<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    独立 Maven 项目，不进 datasophon 根 pom 的模块列表：它是提交到 Flink 集群的作业壳 jar
    （通过 `bin/flink run` 执行，Flink 相关依赖在 provided 作用域，由集群 lib/ 提供），
    与 datasophon-api 这类 Spring Boot 服务的构建/发布节奏无关。把它挂进根 reactor 会让每次
    `./mvnw package` 都去解析整套 Flink 依赖，代价与收益不成比例。
    对应实施方案 T10（血缘发射器）/ T11（CompiledPlan dataset 提取）。

    构建方式（不随根构建触发，需从仓库根用 -f 显式指定本 pom）：
      ./mvnw -f datasophon-lineage-emitter/pom.xml package               # Flink 2.0
      ./mvnw -f datasophon-lineage-emitter/pom.xml package -Pflink-1.20  # Flink 1.20
      ./mvnw -f datasophon-lineage-emitter/pom.xml test                  # 单元测试

    用仓库的 ./mvnw 而不是 `cd` 进来跑 `mvn`：本仓库统一用 Maven Wrapper，开发机上不保证装了
    独立的 mvn（没装时 `mvn package` 直接 127: command not found）。

    ⚠️ 代价：本模块不在根 reactor 里，`./mvnw test` 不会跑到它的测试——其中包括
    SqlSecretRenderer 的注入防护用例。改动本模块后必须显式跑上面的 test 命令。
  -->
  <groupId>com.datasophon</groupId>
  <artifactId>lineage-emitter</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <!--
      故意停在 17，不跟随 datasophon 平台的 JDK 21：这个 jar 运行在 Flink 集群的 JVM 上，
      不是平台自身的进程。编成 21 会在仍跑 JDK 17 的集群上直接 UnsupportedClassVersionError。
      要提高到 21，先确认目标 Flink 集群的 JVM 版本。
    -->
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <flink.version>2.0.2</flink.version>
    <artifact.suffix>flink-2.0</artifact.suffix>
    <openlineage.version>1.29.0</openlineage.version>
  </properties>

  <dependencies>
    <!-- Flink：由 `bin/flink run` 提交时集群 lib/ 已提供同版本 jar，这里只用于编译期签名校验 -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-streaming-java</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-clients</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-table-api-java</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- StreamTableEnvironment（DataStream API 桥接）在 2.0 拆到单独的 bridge 模块 -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-table-api-java-bridge</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-table-common</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- 集群 lib/ 里由 log4j-slf4j-impl 提供实现，这里只声明编译期的 API -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>1.7.36</version>
      <scope>provided</scope>
    </dependency>

    <!--
      与 Gravitino lineage 模块（gravitino/lineage/build.gradle.kts）同版本，
      保证 POST /api/lineage 的 RunEvent JSON 反序列化契约一致（见该模块 LineageOperations.postLineage）。
      openlineage-java 自带 Jackson databind，供本模块解析 CompiledPlan JSON 复用，不再单独声明 Jackson。
    -->
    <dependency>
      <groupId>io.openlineage</groupId>
      <artifactId>openlineage-java</artifactId>
      <version>${openlineage.version}</version>
    </dependency>
    <!-- openlineage-java 把它声明成 runtime scope，本模块要在编译期解析 CompiledPlan JSON，需要 compile scope -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.15.3</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>lineage-emitter-${artifact.suffix}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.datasophon.lineage.LineageSqlRunner</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>flink-1.20</id>
      <properties>
        <flink.version>1.20.4</flink.version>
        <artifact.suffix>flink-1.20</artifact.suffix>
      </properties>
    </profile>
    <profile>
      <id>flink-2.0</id>
    </profile>
  </profiles>
</project>
